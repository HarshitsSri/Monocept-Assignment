            "body": {
              "mode": "raw",
              "raw": "{\n  \"department_name\": \"IT\",\n  \"location\": \"Noida\",\n  \"employees\": [\n    {\n      \"employee_name\": \"Rahul Sharma\",\n      \"email\": \"rahul.sharma@example.com\",\n      \"salary\": 50000\n    },\n    {\n      \"employee_name\": \"Priya Mehta\",\n      \"email\": \"priya.mehta@example.com\",\n      \"salary\": 55000\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 201', function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "try {",
                  "  const json = pm.response.json();",
                  "  if (json && json.id) pm.environment.set('department_id', json.id);",
                  "} catch (e) {}"
                ]
              }
            }
          ]
